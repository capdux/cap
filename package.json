{
  "name": "capdux",
  "version": "1.0.0",
  "private": true,
  "description": "capdux.org — Official CP & Cap Package Registry (Cloudflare Workers + D1 + R2, Zstd .tar.zst + Sparse Index)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply capdux-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply capdux-db --remote",
    "test": "bun test worker/test/",
    "seed": "bun run scripts/seed_official.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.14.0"
  }
}
